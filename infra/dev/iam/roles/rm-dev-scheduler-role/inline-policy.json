{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunSpecificTaskOnSpecificCluster",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:task-definition/rm-dev-scraper-task:*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:cluster/rm-dev-ecs-cluster"
        }
      }
    },
    {
      "Sid": "PassOnlyRequiredRolesToEcs",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/rm-dev-ecs-task-role",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/rm-dev-ecs-exec-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
