{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DdbReadHeadlines",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:DescribeTable"
      ],
      "Resource": "arn:aws:dynamodb:${AWS_REGION}:${AWS_ACCOUNT_ID}:table/Headlines"
    },
    {
      "Sid": "S3PutRunInputs",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::rumour-milled/runs/*"
    },
    {
      "Sid": "S3PutModelArtifacts",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::rumour-milled/models/*"
    }
  ]
}
