{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DdbHeadlinesWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:UpdateItem",
        "dynamodb:DescribeTable"
      ],
      "Resource": "arn:aws:dynamodb:${AWS_REGION}:${AWS_ACCOUNT_ID}:table/Headlines"
    },
    {
      "Sid": "ListTables",
      "Effect": "Allow",
      "Action": ["dynamodb:ListTables"],
      "Resource": "arn:aws:dynamodb:${AWS_REGION}:${AWS_ACCOUNT_ID}:table/*"
    }
  ]
}