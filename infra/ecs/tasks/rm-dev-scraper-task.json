{
  "family": "rm-dev-scraper-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/rm-dev-ecs-exec-role",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/rm-dev-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "scraper",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/rumour-milled/rm-dev-scraper:latest",
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/rm-dev-scraper-task",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
